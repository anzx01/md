# Copy this file to .env and replace every placeholder with your own values.
# Never commit .env or real credentials.

# Database
DATABASE_URL="postgresql://user:password@host:6543/database?pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/database"

# Better Auth
BETTER_AUTH_SECRET="replace-with-a-random-string-at-least-32-characters-long"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# Zhipu AI / OpenAI-compatible API
OPENAI_API_KEY="replace-with-your-zhipu-api-key"
OPENAI_BASE_URL="https://open.bigmodel.cn/api/paas/v4"
ZHIPU_API_KEY="replace-with-your-zhipu-api-key"

# DeepSeek
DEEPSEEK_API_KEY="replace-with-your-deepseek-api-key"
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"

# Feature flags
USE_MOCK_API="false"

# Optional analytics
NEXT_PUBLIC_GA_ID=""

# Optional model overrides
# PLANNER_MODEL="glm-4-flash"
# REALITY_CHECKER_MODEL="glm-4-plus"
# BUDGET_ADVISOR_MODEL="deepseek-chat"
